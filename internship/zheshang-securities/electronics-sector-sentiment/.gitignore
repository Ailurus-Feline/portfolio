# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Data (keep structure, ignore contents)
data/raw/*
!data/raw/.gitkeep
data/raw/~$*
data/raw/*.xlsx
data/processed/*
!data/processed/.gitkeep

# Outputs (regenerable)
output/v1/*
!output/v1/.gitkeep
output/v2/*
!output/v2/.gitkeep

